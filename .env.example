APP_NAME=Budgiette API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/budgiette
SECRET_KEY=change-me-in-production-use-a-long-random-secret-key
JWT_ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_CREDENTIAL_KEY=change-me-generate-a-real-fernet-key-for-this-value
SYNC_INTERVAL_MINUTES=30

